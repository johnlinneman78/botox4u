+        // Phone number check (formatted 10-digit phone or 10-11 consecutive digits)
+        if (/\b\d{3}[-.]?\d{3}[-.]?\d{4}\b/.test(trimmed) || /\b\d{10,11}\b/.test(trimmed)) return false
